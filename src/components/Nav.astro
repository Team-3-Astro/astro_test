---
interface Props {
  activePage?: "forside" | "program" | "trifolium";
  logoSrc?: string;
  ticketHref?: string;
}

const { activePage = "forside", logoSrc = "/images/impact-logo-complete-red.png", ticketHref = "/billetter" } = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => (path.startsWith("/") ? `${basePath}${path}` : path);
const resolvedLogo = logoSrc.startsWith("/") ? withBase(logoSrc) : logoSrc;

const links = [
  { label: "FORSIDE", href: withBase("/"), id: "forside" },
  { label: "PROGRAM", href: withBase("/program"), id: "program" },
  { label: "TRIFOLIUM", href: withBase("/trifolium"), id: "trifolium" },
] as const;
---

<div class="site-header-backdrop" aria-hidden="true"></div>

<a class="site-logo" href={withBase("/")} aria-label="Impact Festival forside">
  <img src={resolvedLogo} alt="Impact Festival" width="2114" height="660" />
</a>

<header class:list={["site-header", { "site-header--home": activePage === "forside" }]}>
  <nav class="site-nav" id="primary-navigation" aria-label="Primær navigation">
    {
      links.map((link) => (
        <a class:list={["site-nav__link", { "site-nav__link--active": activePage === link.id }]} href={link.href} aria-current={activePage === link.id ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>

  <a class="ticket-link" href={withBase(ticketHref)}>BILLETTER</a>

  <button class="menu-button" type="button" aria-label="Åbn menu" aria-controls="primary-navigation" aria-expanded="false">
    <span></span>
    <span></span>
  </button>
</header>

<script>
  const headers = document.querySelectorAll<HTMLElement>(".site-header");
  headers.forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>(".menu-button");
    button?.addEventListener("click", () => {
      const isOpen = header.classList.toggle("site-header--open");
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute("aria-label", isOpen ? "Luk menu" : "Åbn menu");
    });
  });
</script>

<style>
  .site-header-backdrop {
    position: fixed;
    z-index: 999;
    top: 0;
    right: 0;
    left: 0;
    height: 8.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(32, 34, 31, 0.22);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: none;
  }

  .site-header {
    --nav-gap: clamp(2rem, 5vw, 5rem);
    position: fixed;
    z-index: 1000;
    top: 1.75rem;
    right: clamp(1.5rem, 3vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: min(65rem, calc(100% - 19rem));
    height: 5.125rem;
    box-sizing: border-box;
    padding: 0 1rem;
    border-radius: 1.5rem;
    column-gap: var(--nav-gap);
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    font-family: Inter, Arial, Helvetica, sans-serif;
    letter-spacing: 0;
  }

  .site-logo {
    position: fixed;
    z-index: 1001;
    top: 2.6rem;
    left: clamp(1.5rem, 3vw, 3.5rem);
    display: block;
    width: 11rem;
  }

  .site-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--nav-gap);
  }

  .site-nav__link,
  .ticket-link {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  .site-nav__link {
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
  }

  .site-nav__link:hover,
  .site-nav__link--active {
    border-bottom-color: currentColor;
  }

  .ticket-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 10.875rem;
    min-height: 3.5rem;
    padding-inline: 1.5rem;
    border-radius: 1.75rem;
    background: rgba(240, 68, 46, 0.8);
    font-weight: 600;
  }

  .ticket-link:hover {
    background: #f0442e;
  }

  .menu-button {
    display: none;
  }

  .site-logo:focus-visible,
  .site-nav__link:focus-visible,
  .ticket-link:focus-visible,
  .menu-button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
  }
</style>
