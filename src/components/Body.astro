---
import Cards from './Cards.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => path.startsWith('/') ? `${basePath}${path}` : path;

const themes = [
	{
		eyebrow: 'OPDAG',
		description: 'Musik, kunst og talks åbner nye perspektiver.',
		image: '/images/discover.jpg',
		alt: 'Publikum oplever kunst og talks på IMPACT Festival',
	},
	{
		eyebrow: 'DELTAG',
		description: 'Workshops gør idéer konkrete gennem handling.',
		image: '/images/participate.jpg',
		alt: 'Deltagere arbejder kreativt sammen i en workshop',
	},
	{
		eyebrow: 'FORBIND',
		description: 'Mad og fællesskab skaber nye relationer.',
		image: '/images/connect.jpg',
		alt: 'Fælles måltid og samtale på IMPACT Festival',
	},
];

const highlights = [
	{
		title: 'KUNST, TALKS',
		description: 'Udstillinger og samtaler, der gør idéer synlige.',
		image: '/images/art-talks.png',
		alt: 'Kunstnerisk installation på festivalområdet',
	},
	{
		title: 'WORKSHOPS',
		description: 'Skab noget selv og gør idéer konkrete.',
		image: '/images/workshop.png',
		alt: 'Kreativ workshop med materialer og værktøj',
	},
	{
		title: 'MAD, COMMUNITY',
		description: 'Fælles måltider, lokale smage og nye forbindelser.',
		image: '/images/food-community.png',
		alt: 'Mad serveret til et fælles måltid',
	},
];

const socialPosts = [
	{
		title: 'PROGRAMMET I BEVÆGELSE',
		image: '/images/social-program.png',
		alt: 'Et øjeblik fra IMPACT Festivals program',
	},
	{
		title: 'SKAB NOGET SELV',
		image: '/images/workshop.png',
		alt: 'Deltager skaber noget i en workshop',
	},
	{
		title: 'MIDT I OPLEVELSEN',
		image: '/images/social-experience.png',
		alt: 'Festivalgæster midt i en oplevelse',
	},
];
---

<main class="impact-page">
	<section class="mission" aria-labelledby="mission-title">
		<div class="section-shell mission__intro">
			<p class="section-label">HVORFOR IMPACT?</p>
			<h2 id="mission-title">MADE TO INCREASE<br />OUR IMPACT</h2>
			<p class="mission__lead mission__lead--desktop">
				IMPACT Festival samler musik, kunst, talks, workshops og mad på Trifolium.
				Oplevelsen gør store samfundsspørgsmål nærværende gennem mennesker, deltagelse og kultur.
			</p>
			<p class="mission__lead mission__lead--mobile">
				Musik, kunst, talks, workshops og mad bliver til en fælles festivaloplevelse,
				hvor store spørgsmål føles konkrete.
			</p>
		</div>

		<div class="section-shell mission__grid">
			{themes.map((card) => <Cards variant="theme" {...card} />)}
		</div>
	</section>

	<section class="highlights" aria-labelledby="highlights-title">
		<div class="section-shell highlights__heading">
			<p class="section-label">PROGRAMHØJDEPUNKTER</p>
			<h2 id="highlights-title">OPLEV, DELTAG,<br />BLIV HÆNGENDE</h2>
			<p>Tre spor gennem festivalen. Start med det, der kalder på dig.</p>
		</div>

		<div class="section-shell highlights__grid">
			{highlights.map((card) => <Cards variant="highlight" {...card} />)}
		</div>
	</section>

	<section class="social" aria-labelledby="social-title">
		<div class="section-shell social__heading">
			<h2 id="social-title">FRA FESTIVALGULV<br />TIL FEED</h2>
			<p class="section-label">FØLG STEMNINGEN</p>
			<a href="https://www.instagram.com/impactfestival_cph/">@IMPACTFESTIVAL_CPH</a>
		</div>

		<div class="section-shell social__grid">
			{socialPosts.map((card) => <Cards variant="social" {...card} />)}
		</div>
	</section>
</main>

<footer class="site-footer">
	<div class="section-shell site-footer__grid">
		<div class="site-footer__identity">
			<img src={withBase('/images/impact-logo-red.png')} alt="Impact Festival" width="300" height="90" />
			<address>
				11.-12.09.2026<br />
				Trifolium, Bådehavnsgade 42<br />
				2450 København SV
			</address>
		</div>

		<nav aria-label="Navigation i sidefod">
			<a href={withBase('/program')}>PROGRAM</a>
			<a href={withBase('/billetter')}>BILLETTER</a>
			<a href="https://www.instagram.com/impactfestival_cph/">INSTAGRAM</a>
			<a href="mailto:info@impactfestival.dk">KONTAKT</a>
		</nav>

		<form class="newsletter">
			<label for="newsletter-email">FÅ NYHEDER FRA IMPACT</label>
			<input id="newsletter-email" name="email" type="email" placeholder="DIN EMAIL" />
			<button type="submit">TILMELD</button>
		</form>

		<p class="site-footer__legal">© 2026 FORENING IMPACT</p>
	</div>
</footer>

<style>
	.impact-page,
	.site-footer {
		font-family: Inter, Arial, Helvetica, sans-serif;
		letter-spacing: 0;
	}

	.section-shell {
		width: min(80rem, calc(100% - 4rem));
		margin-inline: auto;
	}

	.section-label {
		margin: 0;
		color: #85887f;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.mission {
		padding: 3.6rem 0 5.2rem;
		background: #e8decf;
	}

	.mission__intro {
		text-align: center;
	}

	.mission__intro .section-label {
		display: none;
	}

	.mission h2,
	.highlights h2,
	.social h2 {
		margin: 0;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.mission h2 {
		color: #e71b20;
		font-size: 4.25rem;
		line-height: 1.04;
	}

	.mission__lead {
		max-width: 80rem;
		margin: 1.6rem auto 0;
		color: #03658c;
		font-size: 2.25rem;
		line-height: 1.2;
	}

	.mission__lead--mobile {
		display: none;
	}

	.mission__grid,
	.highlights__grid,
	.social__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(2.5rem, 7vw, 8.5rem);
	}

	.mission__grid {
		margin-top: 7.75rem;
	}

	.highlights {
		padding: 3.7rem 0 1rem;
		background: #ffffff;
		color: #20221f;
	}

	.highlights__heading,
	.social__heading {
		text-align: center;
	}

	.highlights__heading .section-label {
		margin-bottom: 1.5rem;
	}

	.highlights h2 {
		color: #fe0004;
		font-size: 4.5rem;
		line-height: 1.02;
	}

	.highlights__heading > p:last-child {
		margin: 0.2rem 0 0;
		font-size: 1.25rem;
		line-height: 1.45;
	}

	.highlights__grid {
		gap: 2.5rem;
		margin-top: 8.4rem;
	}

	.social {
		padding: 3.75rem 0 4.5rem;
		background: #03658c;
	}

	.social h2 {
		color: #52c0d9;
		font-size: 4.4rem;
		line-height: 1.03;
	}

	.social__heading .section-label {
		margin-top: 4rem;
	}

	.social__heading > a {
		display: inline-block;
		margin-top: 1.15rem;
		color: #ffffff;
		font-size: 1.1rem;
		font-weight: 600;
		text-decoration: none;
	}

	.social__grid {
		gap: clamp(3rem, 8vw, 9rem);
		margin-top: 3.5rem;
	}

	.site-footer {
		padding: 4.6rem 0 3rem;
		background: #e8decf;
		color: #f0442e;
	}

	.site-footer__grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 0.65fr 1.1fr;
		gap: 4rem;
		align-items: start;
	}

	.site-footer__identity img {
		display: block;
		width: 10rem;
		height: auto;
		margin-bottom: 6.8rem;
	}

	.site-footer address {
		font-size: 1rem;
		font-style: normal;
		line-height: 1.5;
	}

	.site-footer nav {
		display: grid;
		gap: 0.8rem;
	}

	.site-footer nav a,
	.newsletter label {
		color: inherit;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
	}

	.newsletter {
		display: grid;
		justify-items: start;
		gap: 1rem;
	}

	.newsletter input {
		width: min(100%, 24.5rem);
		min-height: 3.5rem;
		box-sizing: border-box;
		padding: 0 1rem;
		border: 1px solid currentColor;
		background: transparent;
		color: inherit;
		font: inherit;
	}

	.newsletter input::placeholder {
		color: currentColor;
		opacity: 0.78;
	}

	.newsletter button {
		min-width: 8.25rem;
		min-height: 3.125rem;
		border: 0;
		border-radius: 1.6rem;
		background: rgba(240, 68, 46, 0.8);
		color: #ffffff;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
	}

	.site-footer__legal {
		grid-column: 1 / -1;
		margin: 2rem 0 0;
		color: #85887f;
		font-size: 0.75rem;
	}
</style>
