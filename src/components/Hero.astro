---
import Nav from './Nav.astro';

interface Props {
	activePage?: 'forside' | 'program' | 'trifolium';
	description?: string;
	heroImage?: string;
	programHref?: string;
	ticketHref?: string;
}

const {
	activePage = 'forside',
	description =
		'To dage med kultur, fællesskab og konkrete handlinger, der øger vores impact.',
	heroImage =
		'https://images.squarespace-cdn.com/content/v1/68305df4506cf643363757d3/6fcd1251-82ba-4b27-a674-f6a10d794e7e/0.jpg',
	programHref = '/program',
	ticketHref = '/billetter',
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
	<img
		class="hero__image"
		src={`${heroImage}?format=2500w`}
		srcset={`${heroImage}?format=1000w 1000w, ${heroImage}?format=1500w 1500w, ${heroImage}?format=2500w 2500w`}
		sizes="100vw"
		width="1080"
		height="1350"
		alt="Thomas Asbæk sidder ved et bord med en lysestage og en stor buket blomster"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero__overlay" aria-hidden="true"></div>

	<Nav activePage={activePage} ticketHref={ticketHref} />

	<div class="hero__content">
		<h1 id="hero-title" class="hero__title">
			<span>IMPACT</span>
			<span>FESTIVAL</span>
		</h1>

		{description && <p class="hero__description">{description}</p>}

		<div class="hero__actions">
			<a class="button button--light" href={programHref}>SE PROGRAM</a>
			<a class="button button--accent" href={ticketHref}>KØB BILLET</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		min-height: 100svh;
		overflow: hidden;
		isolation: isolate;
		background: #8f426f;
		font-family: Arial, Helvetica, sans-serif;
		letter-spacing: 0;
	}

	.hero__image,
	.hero__overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__image {
		z-index: -2;
		object-fit: cover;
		object-position: center 48%;
	}

	.hero__overlay {
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(34, 10, 28, 0.28) 0%, rgba(34, 10, 28, 0.08) 62%),
			rgba(112, 42, 91, 0.34);
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-self: flex-end;
		width: min(74rem, 88vw);
		box-sizing: border-box;
		padding: 0 0 clamp(3rem, 8vh, 7rem) clamp(1.25rem, 6vw, 7rem);
		color: #ffffff;
	}

	.hero__title {
		display: flex;
		flex-direction: column;
		align-self: center;
		margin: 0 0 clamp(3rem, 8vh, 7rem);
		color: #f20b19;
		font-family: 'Arial Black', Arial, Helvetica, sans-serif;
		font-size: clamp(4.25rem, 9.5vw, 10.75rem);
		font-weight: 900;
		line-height: 0.72;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.hero__description {
		max-width: 43rem;
		margin: 0 0 2.75rem;
		font-size: clamp(1.25rem, 2vw, 2.1rem);
		line-height: 1.45;
		text-wrap: balance;
		text-shadow: 0 2px 20px rgba(0, 0, 0, 0.45);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 15rem;
		box-sizing: border-box;
		padding: 1.25rem 2rem;
		border-radius: 999px;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			color 160ms ease;
	}

	.button--light {
		background: rgba(255, 255, 255, 0.88);
		color: #1d1d1b;
		backdrop-filter: blur(8px);
	}

	.button--light:hover {
		background: #ffffff;
	}

	.button--accent {
		background: rgba(227, 74, 59, 0.94);
		color: #ffffff;
		backdrop-filter: blur(8px);
	}

	.button--accent:hover {
		background: #c9362c;
	}

	.button:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 4px;
	}

	@media (max-width: 760px) {
		.hero {
			min-height: 52rem;
		}

		.hero__image {
			object-position: 52% center;
		}

		.hero__overlay {
			background:
				linear-gradient(180deg, rgba(34, 10, 28, 0.14) 30%, rgba(24, 8, 20, 0.76) 100%),
				rgba(112, 42, 91, 0.28);
		}

		.hero__content {
			width: 100%;
			padding: 0 1.25rem 2.25rem;
		}

		.hero__title {
			align-self: flex-start;
			margin-bottom: 2.5rem;
			font-size: clamp(3.2rem, 17vw, 5.5rem);
		}

		.hero__description {
			max-width: 30rem;
			margin-bottom: 1.75rem;
			font-size: 1.2rem;
		}

		.hero__actions {
			gap: 0.75rem;
		}

		.button {
			min-width: 0;
			flex: 1 1 9rem;
			padding: 1rem 1.25rem;
			font-size: 0.9rem;
		}
	}
</style>
